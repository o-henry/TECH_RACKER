# Application
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
POSTGRES_DB=technology_tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+asyncpg://tracker:change-this-password@db:5432/technology_tracker

# Source API identity
# SEC requires a declared User-Agent with organization/application and contact information.
SEC_USER_AGENT=TechnologyTracker/0.2 contact@example.com
OPENALEX_MAILTO=contact@example.com
OPENALEX_API_KEY=

# Ingestion limits
OPENALEX_LOOKBACK_DAYS=14
OPENALEX_INITIAL_LOOKBACK_DAYS=3650
OPENALEX_PAGE_SIZE=100
OPENALEX_MAX_PAGES_PER_QUERY=4
CLINICAL_TRIALS_LOOKBACK_DAYS=30
CLINICAL_TRIALS_INITIAL_LOOKBACK_DAYS=3650
CLINICAL_TRIALS_PAGE_SIZE=100
CLINICAL_TRIALS_MAX_PAGES_PER_QUERY=5
SEC_LOOKBACK_DAYS=120
SEC_INITIAL_LOOKBACK_DAYS=730
SEC_MAX_FILINGS_PER_COMPANY=80
SEC_FETCH_DOCUMENTS=true
SEC_MAX_DOCUMENT_BYTES=10000000
SEC_REQUESTS_PER_SECOND=2
RSS_MAX_FEED_BYTES=2000000
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4

# Scheduled refreshes, interpreted in SCHEDULER_TIMEZONE.
SCHEDULER_TIMEZONE=Asia/Seoul
RSS_CRON=*/10 * * * *
OPENALEX_CRON=17 03 * * *
CLINICAL_TRIALS_CRON=41 */4 * * *
SEC_CRON=7,37 * * * *
SCHEDULER_RUN_ON_STARTUP=true

# Private service-to-service controls. These are not OpenAI credentials.
# Generate different random values of at least 32 characters.
BACKEND_CONTROL_TOKEN=replace-with-random-server-control-token
MCP_INTERNAL_TOKEN=replace-with-random-oauth-proxy-token

# ChatGPT Scheduled Task budget. No OPENAI_API_KEY is used.
ANALYSIS_BATCH_SIZE=10
ANALYSIS_DAILY_BATCH_LIMIT=6
ANALYSIS_CRITICAL_BURST_PER_HOUR=2
ANALYSIS_LEASE_MINUTES=20

# Paths inside the container
TRACKING_CONFIG_PATH=/app/config/tracking.yml
SEED_DATA_PATH=/app/seed/technologies.json
RSS_FEEDS_PATH=/app/config/rss_feeds.yml
FRONTEND_DIR=/app/frontend-disabled
