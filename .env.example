# External read-only FastAPI origin. Production must use HTTPS.
PUBLIC_API_BASE_URL=https://api.example.com

# Private automation control origin. Production must use HTTPS.
# This is the companion FastAPI/MCP service; it does not call the OpenAI API.
PRIVATE_AUTOMATION_BASE_URL=https://automation.example.com

# Random, server-only bearer secret shared by Sites and the automation backend.
# Never expose this value to browser JavaScript, URLs, or localStorage.
BACKEND_CONTROL_TOKEN=replace-with-at-least-32-random-bytes
